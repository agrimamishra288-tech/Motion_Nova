# Firebase Admin credentials. For local development this can be a path to a
# downloaded Firebase service-account JSON file. Do not commit that file.
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# For a cloud host, paste the whole service-account JSON into this secret
# instead of uploading a credentials file. Use either this OR the variable above.
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}

# Comma-separated URLs allowed to call the API.
CORS_ORIGINS=http://localhost:5173,https://your-vercel-app.vercel.app
